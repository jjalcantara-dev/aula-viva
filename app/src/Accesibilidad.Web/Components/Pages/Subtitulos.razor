@page "/subtitulos"
@rendermode InteractiveServer
@using System.Threading.Channels
@using Accesibilidad.Core
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IMotorAsr Motor
@inject Glosario Glosario

<PageTitle>Subtítulos en vivo</PageTitle>

<h1>Subtítulos en vivo</h1>
<p><strong>Motor:</strong> @Motor.Nombre</p>

<button @onclick="AlternarAsync" disabled="@_ocupado">
    @(_capturando ? "Detener" : "Iniciar captura")
</button>

@if (_error is not null)
{
    <p style="color:crimson"><strong>Error:</strong> @_error</p>
}

@if (_capturando || _segmentos.Count > 0)
{
    <h2>Latencia</h2>
    <p style="opacity:.7;font-size:.9rem">
        <strong>Extremo a extremo</strong>: medido por el navegador con un solo reloj —
        incluye red, servidor, motor y pintado. Es lo que espera el alumno.<br />
        <strong>Servidor</strong>: desde que llega el primer fragmento de la ventana
        hasta que sale el texto. Incluye la espera a que la ventana se llene, así que
        nunca baja del tamaño de ventana.
    </p>
    <table>
        <tbody>
            <tr><td>Segmentos</td><td><strong>@_segmentos.Count</strong></td></tr>
            <tr><td>Extremo a extremo — mediana</td><td><strong>@MsD(PercentilIda(50))</strong></td></tr>
            <tr><td>Extremo a extremo — p95</td><td><strong>@MsD(PercentilIda(95))</strong></td></tr>
            <tr><td>Servidor — mediana</td><td>@Ms(Percentil(50))</td></tr>
            <tr><td>Servidor — p95</td><td>@Ms(Percentil(95))</td></tr>
            <tr><td>Frecuencia real</td><td>@_frecuenciaReal Hz</td></tr>
            <tr><td>Preprocesado del navegador</td>
                <td>@(PreprocesadoNavegador ? "activo (supresión de ruido, eco, ganancia)" : "desactivado")</td></tr>
        </tbody>
    </table>

    <h2>Transcripción</h2>
    <div style="font-size:1.4rem; line-height:1.7">
        @foreach (var s in _segmentos.TakeLast(8))
        {
            <p style="opacity:@(s.EsParcial ? "0.6" : "1")">
                @foreach (var trozo in Glosario.Marcar(s.Texto))
                {
                    @* Se renderiza trozo a trozo, escapado por Razor. El texto viene de
                       un modelo y nunca debe interpolarse como marcado. *@
                    if (trozo.EsConcepto)
                    {
                        <mark style="background:#ffe066; font-weight:600; padding:0 .15em">@trozo.Texto</mark>
                    }
                    else
                    {
                        @trozo.Texto
                    }
                }
                <small style="opacity:0.5"> (@Ms(s.Latencia))</small>
            </p>
        }
    </div>
}

@code {
    // 500 ms equilibra latencia y contexto: bloques más cortos reducen el retardo pero
    // dan al modelo menos contexto acústico, lo que empeora el reconocimiento. Es un
    // parámetro a barrer experimentalmente, no una constante sagrada.
    private const int MsPorFragmento = 500;
    private const int FrecuenciaDeseada = 16_000;

    // Preprocesado de audio del navegador. Se deja activo porque es lo que encontrará un
    // centro educativo por defecto, pero su efecto sobre el ASR está sin medir: puede
    // ayudar o perjudicar. Declarado aquí para que sea una decisión, no un descuido.
    private const bool PreprocesadoNavegador = true;

    private readonly List<SegmentoTranscrito> _segmentos = [];
    /// <summary>Latencias de extremo a extremo medidas por el navegador, en ms.</summary>
    private readonly List<double> _idaYVuelta = [];
    private IJSObjectReference? _modulo;
    private DotNetObjectReference<Subtitulos>? _referencia;
    private Channel<FragmentoAudio>? _canal;
    private CancellationTokenSource? _cts;
    private Task? _bombeo;

    private bool _capturando, _ocupado;
    private string? _error;
    private int _frecuenciaReal = FrecuenciaDeseada;

    private async Task AlternarAsync()
    {
        _ocupado = true;
        _error = null;
        try
        {
            if (_capturando) await DetenerAsync();
            else await IniciarAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _capturando = false;
        }
        finally { _ocupado = false; }
    }

    private async Task IniciarAsync()
    {
        _segmentos.Clear();
        _idaYVuelta.Clear();

        // Sin límite y descartando lo más viejo: en subtitulado en vivo, si el motor no
        // da abasto, es preferible perder audio antiguo a acumular retardo indefinido.
        _canal = Channel.CreateBounded<FragmentoAudio>(
            new BoundedChannelOptions(64) { FullMode = BoundedChannelFullMode.DropOldest });

        _cts = new CancellationTokenSource();
        _bombeo = ConsumirAsync(_cts.Token);

        _modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/captura-audio.js");
        _referencia ??= DotNetObjectReference.Create(this);

        _frecuenciaReal = await _modulo.InvokeAsync<int>(
            "iniciar", _referencia, FrecuenciaDeseada, MsPorFragmento, PreprocesadoNavegador);

        _capturando = true;
    }

    private async Task DetenerAsync()
    {
        if (_modulo is not null) await _modulo.InvokeVoidAsync("detener");
        _canal?.Writer.TryComplete();
        if (_cts is not null) await _cts.CancelAsync();
        if (_bombeo is not null)
        {
            try { await _bombeo; } catch (OperationCanceledException) { }
        }
        _capturando = false;
    }

    /// <summary>Llamado desde JS por cada bloque de PCM capturado.</summary>
    /// <param name="secuencia">
    /// La asigna el CLIENTE, no el servidor: es la única forma de emparejar cada
    /// subtítulo con el instante en que salió su audio y cerrar la medida de latencia
    /// con un solo reloj.
    /// </param>
    [JSInvokable]
    public void RecibirFragmento(long secuencia, byte[] pcm)
    {
        _canal?.Writer.TryWrite(new FragmentoAudio(
            Secuencia: secuencia,
            Muestras: pcm,
            FrecuenciaMuestreo: _frecuenciaReal,
            // Marca del servidor: sirve para medir el tiempo de MOTOR, no la latencia
            // de extremo a extremo (esa la cierra el navegador).
            CapturadoEn: DateTimeOffset.UtcNow));
    }

    private async Task ConsumirAsync(CancellationToken ct)
    {
        var fuente = _canal!.Reader.ReadAllAsync(ct);
        await foreach (var segmento in Motor.TranscribirAsync(fuente, ct))
        {
            _segmentos.Add(segmento);
            await InvokeAsync(StateHasChanged);

            // Después de pintar: así el número incluye el renderizado, que es lo que el
            // alumno realmente espera. Preguntar antes lo dejaría fuera.
            if (_modulo is not null)
            {
                var ms = await _modulo.InvokeAsync<double>("marcarRecibido", segmento.Secuencia);
                if (ms >= 0)
                {
                    _idaYVuelta.Add(ms);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private TimeSpan Percentil(int p)
    {
        if (_segmentos.Count == 0) return TimeSpan.Zero;
        var ordenadas = _segmentos.Select(s => s.Latencia).Order().ToList();
        var i = Math.Clamp((int)Math.Ceiling(p / 100.0 * ordenadas.Count) - 1, 0, ordenadas.Count - 1);
        return ordenadas[i];
    }

    private double PercentilIda(int p)
    {
        if (_idaYVuelta.Count == 0) return -1;
        var ordenadas = _idaYVuelta.Order().ToList();
        var i = Math.Clamp((int)Math.Ceiling(p / 100.0 * ordenadas.Count) - 1, 0, ordenadas.Count - 1);
        return ordenadas[i];
    }

    private static string Ms(TimeSpan t) => $"{t.TotalMilliseconds:F0} ms";

    private static string MsD(double ms) => ms < 0 ? "—" : $"{ms:F0} ms";

    public async ValueTask DisposeAsync()
    {
        try { await DetenerAsync(); } catch { /* la página se está cerrando */ }
        _referencia?.Dispose();
        if (_modulo is not null)
        {
            try { await _modulo.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _cts?.Dispose();
    }
}
